# awgscale — every setting of every service, with its default.
# Copy to .env and change what differs; a container gets the same names through
# its environment (stack/compose.yml). Secrets are NOT here: passwords, tokens
# and keys are files on the server, mounted into the one container that needs
# them (see *_FILE and *_SECRET below).

# ── tunnel: the users' tunnel (awg0) and the links to the exits (awgk*) ──────
TUNNEL_IFACE=awg0                         # the users' tunnel interface
TUNNEL_GLOB=                              # set (awgk*) → this process keeps the exit links instead
TUNNEL_DIR=/etc/amnezia/amneziawg         # where the interface files live
TUNNEL_CONF=                              # the users' tunnel file; default <TUNNEL_DIR>/<TUNNEL_IFACE>.conf
TUNNEL_AWG=/usr/bin/awg                   # the host's awg tool (must match the kernel module)
TUNNEL_LINK_TYPE=amneziawg                # kernel link type (tests: dummy)
TUNNEL_GATE_CHAIN=CASCADE                 # the mangle chain that means "the rules are in"
TUNNEL_IP=ip                              # the ip tool (iproute2): its `monitor link` says when a link appears, changes or goes
TUNNEL_PASS=10                            # seconds between two looks at what the kernel does not announce (firewall rules, the gate, new files)
TUNNEL_RETRY_SECONDS=10                   # how soon to listen to the kernel's link events again after they stopped

# ── exits: makes a rented server into an exit, looks after those it made ────
EXITS_ENTRY_ADDR=                         # the entry's public address (the key is accepted on exits only from it)
EXITS_DIR=/etc/amnezia/amneziawg          # where the entry's link files live
EXITS_SECRET=/secret                      # directory with the service's SSH key and known hosts
EXITS_TOKEN_FILE=/run/secrets/exits-token # the bearer token the agent presents
EXITS_PPA_KEY=/ppa/amnezia-ppa.gpg        # the Amnezia PPA key sent to a new server
EXITS_AGENT_SOCKET=/run/vpn-panel/agent.sock
EXITS_AWG=/usr/bin/awg
EXITS_SSH=ssh
EXITS_DSN=host=127.0.0.1 port=5432 dbname=vpn user=vpn connect_timeout=3
EXITS_DB_PASSWORD_FILE=/run/secrets/db-password
EXITS_BIND=127.0.0.1
EXITS_PORT=8793
EXITS_STATS_PORT=9101                     # where an exit's stats service listens, inside its tunnel
EXITS_CLIENT_CONF=                        # the users' tunnel file (its I1 line is reused by the links); default <EXITS_DIR>/awg0.conf
EXITS_REMOTE=                             # the scripts run on an exit server; default: those shipped in the package
EXITS_WAIT=1                              # seconds between two looks while a step waits for something
EXITS_STATE_FILE=                         # keep the state in this file instead of the database (the tests)

# ── users: who may connect to the tunnel ─────────────────────────────────────
USERS_ENDPOINT=                           # the name devices connect to (required)
USERS_IFACE=awg0                          # the users' tunnel interface
USERS_CONF=                               # the file the tunnel boots from; default /etc/amnezia/amneziawg/<USERS_IFACE>.conf
USERS_AWG=/usr/bin/awg                    # the host's awg tool (must match the kernel module)
USERS_DSN=host=127.0.0.1 port=5432 dbname=vpn user=vpn connect_timeout=3
USERS_DB_PASSWORD_FILE=/run/secrets/db-password
USERS_TOKEN_FILE=/run/secrets/users-token # the bearer token the agent presents
USERS_BIND=127.0.0.1
USERS_PORT=8790
USERS_DESCRIPTION=AWG Server              # how the server is called in the AmneziaVPN app
USERS_DNS=172.16.17.1                     # the DNS server devices are given
USERS_KEEPALIVE=33                        # PersistentKeepalive of the devices, seconds
USERS_CLIENT_ALLOWED=0.0.0.0/0, ::/0      # AllowedIPs of the devices
USERS_MAX=240                             # how many users there may be
USERS_IP=ip                               # the ip tool (iproute2): its `monitor link` says when the tunnel comes up
USERS_RETRY_SECONDS=30                    # how soon to ask again when the database or the kernel did not answer

# ── dnsgate: smart DNS for devices without the VPN (DoH + the SNI proxy) ─────
DNSGATE_PROXY_IP=                         # the entry server's public address: what a listed name resolves to (required)
DNSGATE_OWN_NAME=                         # the server's own name: never proxied
DNSGATE_STATIC_ALLOW=                     # addresses that need no personal code, space separated
DNSGATE_ALLOW_HOURS=6                     # for how long the proxy admits an address a valid code was seen from
DNSGATE_UPSTREAM=172.16.17.1:53           # the resolver everything else is forwarded to
DNSGATE_LIST_FILE=/lists/domains-exit.txt # the shared site list, replaced by the agent
DNSGATE_TOKENS_FILE=/lists/dns-tokens.json  # the devices' personal codes, replaced by the agent
DNSGATE_DATA_DIR=/data                    # admissions and the devices' counters, kept between restarts
DNSGATE_BIND=0.0.0.0                      # inside the container; published on loopback only
DNSGATE_PORT=8053                         # DoH
DNSGATE_SNI_PORT=8445                     # the SNI proxy
DNSGATE_SAVE_SECONDS=30                   # seconds between two saves of the admissions

# ── resolver: the keeper of AdGuard Home ─────────────────────────────────────
RESOLVER_BIND=127.0.0.1
RESOLVER_PORT=8792
RESOLVER_TOKEN=/run/secrets/resolver-token  # file with the bearer token the agent presents
RESOLVER_HOME=/opt/AdGuardHome            # the resolver's config and data
RESOLVER_COMMAND=                         # its command line as a JSON list; default: AdGuard Home on the config in RESOLVER_HOME
RESOLVER_DNS=172.16.17.1:53               # where it must listen once started
RESOLVER_HOLD=150                         # a resolver stopped on request starts by itself after this many seconds
RESOLVER_STOP_WAIT=30                     # seconds it is given to exit before it is killed
RESOLVER_LISTEN_WAIT=20                   # seconds a start waits for it to listen
RESOLVER_RETRY=3                          # seconds before a resolver that is not running is started again

# ── watch: the routing rules in the kernel, the health of the exits ──────────
WATCH_BIND=127.0.0.1
WATCH_PORT=8791
WATCH_TOKEN_FILE=/run/secrets/watch-token # the bearer token the agent presents
CASCADE_DIR=/root/awg/cascade             # what the agent compiles and the deploy ships: cascade.conf, the lists, the pins
CASCADE_RUN=/run/cascade                  # the health counters of the exits; they outlive a restart
WATCH_IP=ip                               # the ip tool (iproute2): its `monitor link` says when a tunnel comes up
WATCH_PROBE_SECONDS=15                    # seconds between two probes of the exits
WATCH_SAVE_SECONDS=300                    # seconds between two saves of the addresses learned for the listed domains
WATCH_REFRESH_CHECK_SECONDS=300           # seconds between two looks at whether an address list is due for a refresh
WATCH_REFRESH_DAYS=7                      # an address list older than this is downloaded again
WATCH_REFRESH_RETRY_HOURS=6               # hours before a source that did not answer is asked again
WATCH_APPLY_RETRY_SECONDS=15              # seconds between two attempts to put the rules in at the start
WATCH_APPLY_ATTEMPTS=40                   # attempts before the service goes on without the rules
WATCH_LINK_SETTLE_SECONDS=1               # seconds given to a tunnel that has just come up before it is probed

# ── bot: the Telegram bot of the admin ───────────────────────────────────────
BOT_ADMIN_ID=                             # Telegram id of the admin: the only one the bot answers (required)
BOT_TOKEN_FILE=/run/secrets/bot-token     # file with the bot's Telegram token
BOT_DOMAIN=                               # the name of the entry server: where the invitation pages live
BOT_DATA_DIR=/data                        # where the day's counters (stats.json) are kept between restarts
BOT_API_URL=https://api.telegram.org      # the Telegram Bot API
PANEL_AGENT_SOCKET=/run/vpn-panel/agent.sock   # the agent's unix socket
REPORT_HOUR=9                             # the hour of the daily summary, local time
REPORT_UTC_OFFSET=3                       # local time as hours from UTC (3 is Moscow)
BOT_WATCH_SECONDS=30                      # seconds between two looks at the cascade for the alerts
BOT_SAMPLE_SECONDS=60                     # seconds between two samples of the counters
BOT_POLL_SECONDS=10                       # for how long Telegram may hold a request for updates open
BOT_RETRY_SECONDS=3                       # how soon to ask Telegram again after a failure

# ── panel: the admin panel's server (the page, its API, the invitation pages) ─
PANEL_BIND=127.0.0.1                      # address the server listens on (0.0.0.0 inside its container)
PANEL_PORT=8787                           # the page and its API; Traefik is the only way in
PANEL_AGENT_SOCKET=/run/vpn-panel/agent.sock   # the agent's unix socket: the only thing the server asks
PANEL_PASSWORD_FILE=/data/.password       # the admin's password; made on the first start, never printed
PANEL_BEHIND_TLS_PROXY=0                  # 1 when Traefik ends TLS in front: cookies are Secure, HSTS is sent
PANEL_TLS_CERT=                           # certificate and key, when the server ends TLS itself
PANEL_TLS_KEY=
PANEL_METRICS_PORT=0                      # the port Prometheus scrapes, never published; 0 is no metrics
PANEL_PROMETHEUS_URL=                     # where the traffic history is asked; empty is no history
PANEL_WEB_DIR=/app/web                    # the built page (web/out)
PANEL_FONTS_DIR=/app/fonts                # the page's typefaces
PANEL_INVITE_FILE=/app/invite.html        # the page a person with an invitation link gets
PANEL_POLL_SECONDS=5                      # seconds between two looks at the state of the cascade
PANEL_HISTORY_POINTS=180                  # how many looks the speed chart keeps
PANEL_SESSION_HOURS=12                    # how long a login lasts

# ── agent: carries out what the panel and the bot ask ───────────────────────
VPN_AGENT_SOCKET=/run/vpn-panel/agent.sock   # the unix socket the panel and the bot speak to
VPN_CLIENT_IF=awg0                        # the users' tunnel interface
VPN_USERS_URL=http://127.0.0.1:8790
VPN_USERS_TOKEN_FILE=/opt/vpn-stack/users-secret/token
VPN_WATCH_URL=http://127.0.0.1:8791
VPN_WATCH_TOKEN_FILE=/opt/vpn-stack/watch-secret/token
VPN_RESOLVER_URL=http://127.0.0.1:8792
VPN_RESOLVER_TOKEN_FILE=/opt/vpn-stack/resolver-secret/token
VPN_EXITS_URL=http://127.0.0.1:8793
VPN_EXITS_TOKEN_FILE=/opt/vpn-stack/exits-secret/token
VPN_AGENT_STOP_WAIT=170                      # seconds a running command is waited for on the way out
VPN_AGENT_NIGHTLY_HOUR=2                     # UTC time of the nightly refresh of the lists by link…
VPN_AGENT_NIGHTLY_MINUTE=20
VPN_AGENT_NIGHTLY_JITTER=900                 # …plus up to this many seconds
VPN_AGENT_SAMPLE_SECONDS=5                   # how often the state is looked at; questions are answered from the last look
VPN_AGENT_ONLINE_SECONDS=180                 # a user is online if the tunnel heard from them this recently
VPN_AGENT_DAY_FILE=/run/cascade/day-traffic.json   # the day's traffic per user, kept across a restart of the agent
VPN_AGENT_DAY_KEEP_SECONDS=300               # how often it is written
VPN_AGENT_BACKLOG=128                        # connections that may wait on the socket

VPN_STORE_DSN=host=127.0.0.1 port=5432 dbname=vpn user=vpn connect_timeout=3
VPN_STORE_PASSWORD_FILE=/opt/vpn-stack/db-secret/password
VPN_CASCADE_DIR=/root/awg/cascade         # the files compiled for the routing, and the agent's lock files
VPN_LOKI_URL=http://127.0.0.1:3100            # where the journal is read back from
VPN_JOURNAL_SOCKET=/run/systemd/journal/socket # journald: where the journal is written
VPN_JOURNAL_ID=vpn-journal                   # the identifier its lines carry
VPN_JOURNAL_DAYS=400                         # how far back it is read
VPN_USERS_CACHE_FILE=/run/cascade/panel-clients.json   # the users' list as last asked, kept for a minute
VPN_TUNNEL_FILE=/etc/amnezia/amneziawg/awg0.conf       # who is known when the users service cannot be asked
VPN_RUN_DIR=/run/cascade                  # the exits as servers: where the watch service says which exits work (exit<N>.state)

# agent: blocking (AdGuard) and the smart-DNS devices
VPN_ADGUARD_URL=http://127.0.0.1:3001/control          # AdGuard Home's control API
VPN_ADGUARD_CREDENTIALS_FILE=/root/awg/adguard-admin.txt   # AdGuard's admin name and password, as its installer left them
VPN_ADGUARD_FILTERS_DIR=/opt/AdGuardHome/data/filters  # where AdGuard keeps the block lists it has downloaded
VPN_ADGUARD_QUERYLOG_FILE=/opt/AdGuardHome/data/querylog.json   # AdGuard's query log: the day's most visited sites are counted from it, by name only
VPN_EXIT_STATS_PORT=9101                  # where the small service on an exit says how the server is doing
VPN_DNS_TOKENS_FILE=/opt/vpn-stack/lists/dns-tokens.json    # the devices' codes, compiled for the DNS gate
VPN_DNS_STATE_FILE=/opt/vpn-stack/smartdns-data/state.json  # what the DNS gate keeps about the devices it has seen
VPN_HAGEZI_URL=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/   # HaGeZi's lists (https only): the levels Pro/Pro++/Ultimate and the children's add-on lists
VPN_GROUP_LISTS_FILE=/opt/AdGuardHome/userfilters/group-lists.txt   # …made into one file for AdGuard (inside its safe_fs_patterns), each rule for the groups that need it
VPN_GROUP_LISTS_REFRESH_HOURS=12          # …downloaded again this often while a group needs them
VPN_GROUP_LISTS_MIN_RULES=1000            # …a list with fewer rules is refused, the file in use stays
VPN_GROUP_LISTS_MAX_BYTES=67108864        # …and so is one larger than this
VPN_THREATS_LIST_URL=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/tif.mini.txt   # «Угрозы»: for everybody, put into AdGuard when missing

# agent — sites and routing
VPN_LISTS_DIR=/opt/vpn-stack/lists        # the list of what goes abroad, for the DNS-without-VPN container
VPN_RESOLVER_YAML=/opt/AdGuardHome/AdGuardHome.yaml   # the resolver's own settings
