# secrets: never in the repository
/clients/
panel/.bot-token
panel/.password
bot/admin-id
*.key
*.pem
# the servers' addresses and the site's name (see ssh_config.example, site.env.example)
/ssh_config
/site.env

# local working copies and run output
.backup-*/
logs/
