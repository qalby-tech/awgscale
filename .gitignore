*.pyc
node_modules/

# a reference copy of a third-party installer (github.com/bivlked/amneziawg-installer), not ours to publish
upstream/
.env
.venv/

# the panel page: what the build leaves behind
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
*.tsbuildinfo
.env*.local

# the operator's own scripts and notes (a separate local git repository)
/site/
