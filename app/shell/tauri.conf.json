{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "awgscale",
  "version": "0.1.18",
  "identifier": "tech.qalby.awgscale",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "awgscale",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "category": "Utility",
    "android": {
      "minSdkVersion": 26
    },
    "shortDescription": "Your own VPN network",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "iproute2",
          "nftables"
        ],
        "files": {
          "/usr/bin/qalby": "../target/qalby/qalby",
          "/lib/systemd/system/awgscale.service": "packaging/awgscale.service"
        },
        "postInstallScript": "packaging/postinst.sh",
        "preRemoveScript": "packaging/prerm.sh"
      }
    }
  }
}
