<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- always-on at boot: the service waits for a network before it looks the server's name up -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- a VPN app's foreground service (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- the notification that says the VPN is on (asked for on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android's own question, asked once: may the app run in the background without the battery saver
         stopping it (the tunnel kept through the night, and made anew when the network changes) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <!-- Android binds it as the VPN; it runs in a process of its own, in the foreground while
             the tunnel is on, so that the tunnel outlives the app's window (and its process) -->
        <service
            android:name=".AwgVpnService"
            android:process=":tunnel"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
