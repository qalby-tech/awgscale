{
 "uid": "vpn-cascade",
 "title": "VPN каскад",
 "timezone": "Europe/Moscow",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "tags": [
  "vpn"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Скачано пользователями",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (user) (increase(vpn_user_bytes_total{dir=\"down\"}[$__interval]))",
     "legendFormat": "{{user}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "interval": "1h"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Отправлено пользователями",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (user) (increase(vpn_user_bytes_total{dir=\"up\"}[$__interval]))",
     "legendFormat": "{{user}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "interval": "1h"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Выходы и подключённые",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "vpn_exit_up",
     "legendFormat": "{{exit}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "vpn_users_online",
     "legendFormat": "в сети",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "logs",
   "title": "Журнал изменений",
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 12
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "sortOrder": "Descending",
    "wrapLogMessage": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{job=\"vpn-journal\"} | json | line_format \"{{.who}} · {{.text}}\"",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ]
}