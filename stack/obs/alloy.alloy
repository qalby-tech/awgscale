// Ships the panel's change journal from the host's journald to Loki.
// Only entries written under the identifiers below leave the host: other
// services' logs can carry site names per client and are not to be stored.
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal_syslog_identifier"]
    regex         = "vpn-journal(-test)?|vpn-deadman"
    action        = "keep"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "job"
  }
}

loki.source.journal "host" {
  forward_to    = [loki.write.local.receiver]
  relabel_rules = loki.relabel.journal.rules
  max_age       = "168h"
  labels        = {}
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
